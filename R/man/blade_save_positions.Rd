\name{blade_save_positions}
\alias{blade_save_positions}
\title{Save updated tissue positions}
\usage{
blade_save_positions(tissue, out_path)
}
\arguments{
  \item{tissue}{A BLADE tissue list.}
  \item{out_path}{Output CSV path.}
}
\value{Invisibly returns the output path.}
\description{Writes tissue_positions.csv with updated in_tissue values.}
